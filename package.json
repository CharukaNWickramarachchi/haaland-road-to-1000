{
  "name": "haaland-road-to-1000",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-data && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-canonical": "tsx scripts/build-canonical-goals.ts",
    "import-goals": "tsx scripts/import-goals.ts",
    "import-city": "tsx scripts/import-city-from-fbref.ts",
    "import-norway": "tsx scripts/import-norway-from-fbref.ts",
    "detect-goals": "tsx scripts/fetch-latest-haaland-goals.ts",
    "append-goals": "tsx scripts/append-goal-batch.ts",
    "check-data": "npm run build-canonical && npm run validate-data && npm run reconcile-data",
    "validate-data": "tsx scripts/validate-data.ts",
    "reconcile-data": "tsx scripts/reconcile-baseline.ts",
    "verify": "npm run check-data && npm run test && tsc -b && vite build",
    "promote-goals": "tsx scripts/promote-verified-candidates.ts",
    "sync-data-version": "tsx scripts/sync-data-version.ts",
    "refresh-canonical": "npm run promote-goals && npm run build-canonical && npm run sync-data-version && npm run validate-data && npm run sync-baseline && npm run reconcile-data",
    "sync-baseline": "tsx scripts/sync-verified-baseline.ts",
    "auto-update": "npm run detect-goals && npm run promote-goals && npm run build-canonical && npm run sync-data-version && npm run validate-data && npm run sync-baseline && npm run reconcile-data && npm run test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
